# ============================================================================
# Quantitative Prediction Engine - Environment Configuration Template
# ============================================================================

# General Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
PROJECT_NAME="News-Driven Quantitative Prediction Engine"
API_V1_PREFIX=/api/v1

# Relational Metadata Persistence (SQLite / PostgreSQL)
DATABASE_URL=sqlite+aiosqlite:///./quant.db
DATABASE_ECHO=false

# Embedded Columnar Market Data (DuckDB)
DUCKDB_PATH=data/market_data.duckdb

# Security Secrets (Generate cryptographically random strings in production)
API_KEY_SECRET=dev-secret-api-key-992384918237192837
JWT_SECRET_KEY=dev-jwt-super-secret-key-change-in-production-12983719283
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Broker Gateway Configuration
# Options: "paper" (high-fidelity in-memory paper broker) or "alpaca" (live/paper Alpaca Markets)
BROKER_TYPE=paper

# Alpaca Markets API Credentials (https://app.alpaca.markets/paper/dashboard/overview)
# For Paper Trading: Use paper keys and paper endpoint
# For Live Trading: Use live keys and set ALPACA_BASE_URL=https://api.alpaca.markets
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets

# Autonomous Swarm Trading Loop
TRADING_UNIVERSE=["SPY","QQQ","AAPL","NVDA","MSFT"]
AUTONOMOUS_LOOP_INTERVAL_SEC=60.0
MIN_TRADE_NOTIONAL=100.0
