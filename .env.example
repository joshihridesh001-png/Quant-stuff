# ============================================================================
# Quantitative Prediction Engine - Environment Configuration Template
# ============================================================================

# General Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
PROJECT_NAME="News-Driven Quantitative Prediction Engine"
API_V1_PREFIX=/api/v1

# Relational Metadata Persistence (SQLite / PostgreSQL)
DATABASE_URL=sqlite+aiosqlite:///./quant.db
DATABASE_ECHO=false

# Embedded Columnar Market Data (DuckDB)
DUCKDB_PATH=data/market_data.duckdb

# Security Secrets (Generate cryptographically random strings in production)
API_KEY_SECRET=dev-secret-api-key-992384918237192837
JWT_SECRET_KEY=dev-jwt-super-secret-key-change-in-production-12983719283
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Broker Gateway Configuration
# Options: "paper" (high-fidelity in-memory paper broker) or "alpaca" (live/paper Alpaca Markets)
BROKER_TYPE=paper

# Alpaca Markets API Credentials (https://app.alpaca.markets/paper/dashboard/overview)
# For Paper Trading: Use paper keys and paper endpoint
# For Live Trading: Use live keys and set ALPACA_BASE_URL=https://api.alpaca.markets
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets

# Autonomous Swarm Trading Loop
TRADING_UNIVERSE=["SPY","QQQ","AAPL","NVDA","MSFT"]
AUTONOMOUS_LOOP_INTERVAL_SEC=60.0
MIN_TRADE_NOTIONAL=100.0

# ============================================================================
# External Quantitative Data Providers (Selected from public-apis)
# All keys below are optional. The platform safely operates in offline mock
# mode when keys are omitted. Add your keys to unlock real-world data streams.
# ============================================================================

# 1. FRED (Federal Reserve Economic Data)
# Registration: https://fred.stlouisfed.org/docs/api/api_key.html (Free)
# Utility: Macro yield curve inversion (T10Y2Y), Fed Funds Rate (DFF), CPI Inflation
FRED_API_KEY=

# 2. Finnhub Stock & Financial Data
# Registration: https://finnhub.io/register (Free: 60 calls/min)
# Utility: Real-time stock quotes, company news, earnings calendar, analyst price targets
FINNHUB_API_KEY=

# 3. NewsAPI.org
# Registration: https://newsapi.org/register (Free: 100 requests/day)
# Utility: Live breaking business and financial news from 80,000+ publications
NEWS_API_KEY=

# 4. Polygon.io
# Registration: https://polygon.io/ (Free: 5 calls/min, end-of-day + 15m delayed)
# Utility: Institutional US equity aggregate bars, trade ticks, reference data
POLYGON_API_KEY=

# 5. Alpha Vantage
# Registration: https://www.alphavantage.co/support/#api-key (Free: 25 requests/day)
# Utility: Pre-computed technical indicators (RSI, MACD, SMA), global forex rates
ALPHA_VANTAGE_API_KEY=

# 6. Twelve Data
# Registration: https://twelvedata.com/ (Free: 800 calls/day, 8 calls/min)
# Utility: Real-time and historical multi-asset market data (equities, forex, crypto)
TWELVE_DATA_API_KEY=

# 7. Financial Modeling Prep (FMP)
# Registration: https://site.financialmodelingprep.com/developer/docs (Free: 250 calls/day)
# Utility: Corporate balance sheets, cash flows, DCF valuation, earnings surprises
FMP_API_KEY=

# 8. OpenFIGI (Bloomberg Symbology)
# Registration: https://www.openfigi.com/api (Free)
# Utility: Cross-asset ticker, CUSIP, ISIN, and FIGI mapping
OPENFIGI_API_KEY=

# 9. SEC EDGAR User-Agent
# Standard: "SampleCompany AdminContact@domain.com" (Free, public domain)
# Utility: Form 8-K material events, 10-Q quarterly reports, 10-K filings
SEC_EDGAR_USER_AGENT="QuantEngine Research Contact@quantplatform.internal"

# 10. Binance Spot Market Data
# Registration: https://www.binance.com (Optional for public endpoints)
# Utility: 24/7 high-frequency crypto spot order book depth and trade ticks
BINANCE_API_KEY=

