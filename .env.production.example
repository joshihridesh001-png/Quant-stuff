# ==============================================================================
# Quant Alpha Engine - Production Environment Configuration Template
# Copy this file to .env and populate with production secrets before deployment.
# ==============================================================================

# --- System & Deployment ---
ENVIRONMENT=production
LOG_LEVEL=INFO
PROJECT_NAME="News-Driven Quantitative Prediction Engine"
API_V1_PREFIX=/api/v1

# --- Databases ---
# Primary Transactional Database (PostgreSQL with pgvector recommended for production)
DATABASE_URL=postgresql+asyncpg://quant_user:quant_password@postgres:5432/quant_db
DATABASE_ECHO=false

# Embedded High-Throughput Columnar Market Data Store
DUCKDB_PATH=/app/data/market_data.duckdb

# --- Cryptographic Authentication & Security ---
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_THIS_TO_A_SECURE_64_CHAR_HEX_SECRET_KEY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
API_KEY_SECRET=CHANGE_THIS_TO_A_SECURE_API_SECRET_KEY
ADMIN_TOKEN=CHANGE_THIS_TO_SECURE_ADMIN_DISARM_TOKEN

# --- Cross-Origin Resource Sharing (CORS) ---
# JSON string array of trusted domain origins
CORS_ORIGINS=["https://terminal.yourdomain.com", "http://localhost:8000"]

# --- Execution Broker & Gateway ---
# Supported options: "paper" | "alpaca"
BROKER_TYPE=paper
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets

# --- Autonomous Swarm Engine ---
TRADING_UNIVERSE=["SPY", "QQQ", "AAPL", "NVDA", "MSFT"]
AUTONOMOUS_LOOP_INTERVAL_SEC=60.0
MIN_TRADE_NOTIONAL=100.0

# --- External Macroeconomic & Market Data Providers ---
# Register free keys at respective developer portals:
# FRED (Federal Reserve Economic Data): https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Finnhub Stock & Financial News API: https://finnhub.io/
FINNHUB_API_KEY=

# Polygon.io Equities Aggregates: https://polygon.io/
POLYGON_API_KEY=

# Alpha Vantage Technical Indicators: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# Twelve Data Core Indicators: https://twelvedata.com/
TWELVE_DATA_API_KEY=

# Financial Modeling Prep (FMP): https://site.financialmodelingprep.com/
FMP_API_KEY=

# NewsAPI Global Headlines: https://newsapi.org/
NEWS_API_KEY=

# OpenFIGI Identifier Mapping: https://www.openfigi.com/api
OPENFIGI_API_KEY=

# SEC EDGAR User Agent Format: "Sample Company Name AdminContact@domain.com"
SEC_EDGAR_USER_AGENT=QuantEngine Research Contact@quantplatform.internal
